{
  "name": "lofi-reconciliation",
  "version": "0.1.0",
  "private": true,
  "description": "LOFI payout reconciliation: rebuilds eBay and Shopify payouts into individual sales with GST worked out per LOFI's approved scenarios. Report-only (milestone 1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lofi-recon --local",
    "db:migrate:remote": "wrangler d1 migrations apply lofi-recon --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "demo:sql": "mkdir -p .wrangler && vite-node scripts/demo-sql.ts > .wrangler/demo.sql",
    "demo:load": "wrangler d1 execute lofi-recon --local --file .wrangler/demo.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
