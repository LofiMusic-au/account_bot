# Copy to .dev.vars (git-ignored) and fill in. Put any value containing "#"
# in double quotes (eBay refresh tokens do): unquoted, "#" starts a comment. Used by `npm run dev` (Wrangler)
# and by `npm run live:validate`. Production secrets go in with
# `npx wrangler secret put <NAME>` instead; never commit real values.

# Shopify app from the Dev Dashboard (App settings > Credentials), installed on
# the store with read_orders, read_shopify_payments_payouts and
# read_shopify_payments_accounts. The code swaps these for a 24-hour token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for an older admin-created custom app that shows a shpat_ token:
# SHOPIFY_ADMIN_TOKEN=

# eBay developer app + user refresh token: sell.finances, sell.fulfillment.readonly
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName: developer portal > User Tokens > "Get a Token from eBay via Your Application"
EBAY_RUNAME=
# Filled in for you by `npm run ebay:consent`:
EBAY_REFRESH_TOKEN=
# Optional instead of the three above, for one-off validation runs only:
# EBAY_ACCESS_TOKEN=

# Optional: protects the local dashboard
# DASHBOARD_TOKEN=

# Local only: shows a "Clear all payouts" button. Leave unset in production.
ALLOW_DATA_RESET=true
